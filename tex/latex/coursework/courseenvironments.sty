% Shared theorem and display environments. No font selection.
\NeedsTeXFormat{LaTeX2e}[2026-06-01]
\ProvidesPackage{courseenvironments}[2026/09/11 v2.0.0 Coursework environments]
\RequirePackage{coursemath}
\RequirePackage{amsthm}
\RequirePackage{booktabs}
\RequirePackage{float}
\RequirePackage{enumitem}
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{conjecture}[theorem]{Conjecture}
\newtheorem{algorithm}[theorem]{Algorithm}
\theoremstyle{remark}
\newtheorem{remark}{Remark}[section]
\newtheorem*{note}{Note}\newtheorem*{caveat}{Caveat}\newtheorem*{warning}{Warning}
\theoremstyle{definition}
\newtheorem{definition}{Definition}[section]
\newtheorem{example}{Example}[section]
\newtheorem{summary}{Summary}[subsection]
\newtheorem*{question}{Question}\newtheorem*{speculation}{Speculation}
\newcounter{formula}
\newenvironment{formula}[1][]{%
  \refstepcounter{formula}%
  \def\course@formulatitle{#1}%
  \ifx\course@formulatitle\@empty
    \edef\course@formulatitle{Formula \arabic{formula}}%
  \fi
  % Preserve formula's own reference identity across amsmath's display setup.
  \edef\course@formulalabel{\theformula}%
  \ifdefined\@currentHref\let\course@formulahref\@currentHref\fi
  \ifdefined\cref@currentlabel\let\course@formulacref\cref@currentlabel\fi
  \begin{equation*}%
  \tag*{\parbox{5em}{\textbf{\small\course@formulatitle}}}%
  \gdef\df@tag{%
    \maketag@@@{\parbox{5em}{\textbf{\small\course@formulatitle}}}%
    \edef\@currentlabel{\course@formulalabel}\def\@currentcounter{formula}%
    \ifdefined\course@formulahref\let\@currentHref\course@formulahref\fi
    \ifdefined\course@formulacref\let\cref@currentlabel\course@formulacref\fi}%
}{\end{equation*}}
\NewDocumentEnvironment{subparts}{}{\begin{enumerate}[label=(\alph*)]\vspace{-1ex}}{\end{enumerate}}
\newcommand\tableheading[2]{\multicolumn{1}{c}{\genfrac{}{}{0pt}{}{\text{#1}}{\text{#2}}}}
\ExplSyntaxOn
\tl_new:N \g__course_table_placement_tl
\tl_gset:Nn \g__course_table_placement_tl {ht!}
\skip_new:N \g__course_table_skip
\skip_gset:Nn \g__course_table_skip {-1em}
\keys_define:nn {coursework/environments}
 {table-placement .tl_gset:N=\g__course_table_placement_tl,
  table-top-skip .skip_gset:N=\g__course_table_skip}
\NewDocumentCommand\courseenvironmentsetup{m}{\keys_set:nn{coursework/environments}{#1}}
\tl_new:N \l__course_table_caption_tl
\tl_new:N \l__course_table_label_tl
\tl_new:N \l__course_table_placement_tl
\keys_define:nn {coursework/table}
 {caption .tl_set:N=\l__course_table_caption_tl,
  label .tl_set:N=\l__course_table_label_tl,
  placement .tl_set:N=\l__course_table_placement_tl}
\cs_new_protected:Npn \__course_table_begin:n #1 {\begin{table}[#1]}
\NewDocumentEnvironment{mathtable}{O{}m}
 {\tl_clear:N\l__course_table_caption_tl\tl_clear:N\l__course_table_label_tl
  \tl_set_eq:NN\l__course_table_placement_tl\g__course_table_placement_tl
  \keys_set:nn{coursework/table}{#1}
  \tl_if_empty:NT\l__course_table_caption_tl
    {\tl_if_empty:NF\l__course_table_label_tl
       {\PackageError{courseenvironments}{A~table~label~requires~a~caption}{Supply~caption={...}.}}}
  \vspace{\g__course_table_skip}
  \exp_args:NV\__course_table_begin:n\l__course_table_placement_tl
  \small\begin{center}\begin{displaymath}\begin{array}{#2}\toprule}
 {\end{array}\end{displaymath}
  \tl_if_empty:NF\l__course_table_caption_tl
    {\vspace{-1em}\caption{\l__course_table_caption_tl}
     \tl_if_empty:NF\l__course_table_label_tl{\exp_args:NV\label\l__course_table_label_tl}}
  \end{center}\end{table}\vspace{-1em}}
\AddToHook{package/cleveref/after}{
 \IfPackageLoadedT{cleveref}{
  \crefname{theorem}{theorem}{theorems}\crefname{lemma}{lemma}{lemmas}
  \crefname{corollary}{corollary}{corollaries}\crefname{proposition}{proposition}{propositions}
  \crefname{conjecture}{conjecture}{conjectures}\crefname{algorithm}{algorithm}{algorithms}
  \crefname{remark}{remark}{remarks}\crefname{definition}{definition}{definitions}
  \crefname{example}{example}{examples}\crefname{summary}{summary}{summaries}
  \crefname{formula}{formula}{formulas}}}
\ExplSyntaxOff
\endinput
