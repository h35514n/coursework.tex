% =====================================================================
% coursemath.sty -- Shared math macros and environments for coursework
%   documents. Required by both coursenotes.cls and coursepsets.cls.
%
% The definitions here were factored out of the former notes.cls and
% problemsets.cls. Where the two disagreed, the problemsets.cls
% definition was kept, since that class carries all the real content.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{coursemath}[2026/09/05 v1.0 Shared math macros for coursework documents]

% Loaded here so the package stands on its own. \RequirePackage is
% idempotent, so when a class has already loaded these in its own
% deliberate order (e.g. amsmath before mathspec), these are no-ops and
% that order is preserved.
\RequirePackage{amssymb}
\RequirePackage{mathtools}                          % Loads amsmath.
\RequirePackage{amsthm}                             % Used for theorem environments. Keep after amsmath.
\RequirePackage{bigints}                            % Larger integral signs
\RequirePackage{bm}                                 % For bold math symbols
\RequirePackage{booktabs}                           % Required. Used for mathtable environment.
\RequirePackage[spaced, mleftright]{diffcoeff}      % For \diff and \diffp commands
\RequirePackage{enumitem}                           % Used for the enumerate environment.
\RequirePackage{float}                              % Use H to suppress table float
\RequirePackage{graphicx}                           % Used for inserting images.
\RequirePackage{pgfkeys}                            % For mathtable environment.
\RequirePackage{siunitx}                            % For SI units.
\RequirePackage{xifthen}                            % Conditional constructs

% ================== SI Units setup ==================
\sisetup{group-separator = {,}}

% ============= Mathematical Symbols =============
\providecommand{\NN}{\ensuremath{\mathbb{N}}}
\providecommand{\ZZ}{\ensuremath{\mathbb{Z}}}
\providecommand{\QQ}{\ensuremath{\mathbb{Q}}}
\providecommand{\RR}{\ensuremath{\mathbb{R}}}
\providecommand{\CC}{\ensuremath{\mathbb{C}}}
\providecommand{\pd}{\partial}   % 'dee' symbol for partial derivatives
\providecommand{\dd}{\mathrm{d}} % 'dee' symbol for ordinary derivatives
\providecommand{\fdd}[2]{\frac{\dd#1}{\dd#2}}
\providecommand{\fdl}[2]{\frac{\dd^2#1}{\dd#2^2}}
\providecommand{\pdd}[2]{\frac{\pd#1}{\pd#2}}
\providecommand{\pdl}[2]{\frac{\pd^2#1}{\pd#2^2}}
\providecommand{\x}{\times}
\providecommand{\n}{\scalebox{0.6}[1.0]{\ensuremath{-}}}
\providecommand{\qeq}{\stackrel{\text{\small{?}}}{=}}
\providecommand{\cheq}{\stackrel{\text{\small{\cmark}}}{=}}
\providecommand{\creq}{\stackrel{\text{\small{\xmark}}}{=}}
\providecommand{\comb}[2]{{}^{#1}C_{#2}}   % Combination
\providecommand{\perm}[2]{{}^{#1}\!P_{#2}} % Permutation

% ============= Mathematical Macros =============
\providecommand{\Sum}[3][n]{\ensuremath{\sum_{{#1}={#2}}^{#3}}}							% Sum from [n]={1}to{2}.     \Sum{1}{10}
\providecommand{\infsum}[2][n]{\ensuremath{\sum_{{#1}={#2}}^\infty}}					% Infinite sum from [n]={1}  \infsum{1}
\providecommand{\Int}[4][x]{\ensuremath{\int_{#2}^{#3}\!{#4}\,\mathrm{d}{#1}}}			% Integrate {1} from {2} to {3} with respect to [x]
\providecommand{\Lim}[3][\infty]{\ensuremath{\displaystyle \lim_{{#2}\to{#1}}\!\!{#3}}} % Take the limit from {1} to [infinity] of {3} \Lim{x}{f(x)}
\providecommand{\sfrac}[2]{\ensuremath{\,^{#1}\!/\!_{#2}\,}}							% Slanted fraction with proper spacing. Useful for in-line display of fractions.
\providecommand{\Eval}[3]{ % chktex 15
	\ensuremath{%
		\left\lbrack#3 \right\rvert_{#1}^{#2}
	} % chktex 9
}%
\providecommand{\eval}[3]{ % chktex 15
	\ensuremath{%
		\left. #3 \right\rvert_{#1}^{#2}
	} % chktex 9
}%
\renewcommand{\L}{\left}								% for left-hand right-sizing  % chktex 43
\providecommand{\R}{\right}								% for right-hand right-sizing % chktex 43
\providecommand{\D}{\diff}								% for writing derivatives
\providecommand{\PD}{\diffp}							% for writing partial derivatives
\providecommand{\full}{\displaystyle}					% Forces display style in math mode
\providecommand{\Deg}{\ensuremath{^\circ}}				% for adding a degree symbol, even if not in math mode
\providecommand{\abs}[1]{\left\lvert#1 \right\rvert}    % Absolute Value
\providecommand{\norm}[1]{\left\Vert#1 \right\Vert}		% Norm (vector magnitude)
\providecommand{\e}[1]{\ensuremath{\times 10^{#1}}}		% Scientific Notation with times symbol
\providecommand{\E}[1]{\ensuremath{10^{#1}}}			% Scientific Notation
\renewcommand{\u}[1]{\text{ #1}}						% For inserting units in Roman text
\providecommand{\mc}{\text{,}\hspace{1em}}				% For inserting comma and space into math mode

% For inserting text into math mode with space on either side. Option for preceding punctuation.
\providecommand{\mtxt}[2][]{#1\hspace{0.5em}\text{#2}\hspace{0.5em}}
\providecommand{\nth}{n\text{th}}
\providecommand{\ith}{i\text{th}}

% ============= Delimiters =============
\providecommand{\mean}[1]{\ensuremath{\left\langle#1\right\rangle} }
\providecommand{\var}[1]{\ensuremath{\mathrm{Var}(#1)} }
\providecommand{\p}[1]{\ensuremath{\left(#1\right)} }
\providecommand{\bs}[1]{\ensuremath{\left[#1\right]}}
\providecommand{\bc}[1]{\ensuremath{\left[#1\right]}}

% ============= Probability and Statistics =============
\providecommand{\prob}[1]{\ensuremath{P\!\left(#1\right)} }
\providecommand{\cndprb}[2]{\ensuremath{P\!\left(#1 \left\lvert  #2 \right.  \right)} }
\providecommand{\cov}[1]{\ensuremath{\text{Cov}\!\left(#1\right)} }
\providecommand{\ex}[1]{\ensuremath{E\!\left[#1\right]} }

% ============= Linear Algebra =============
% Column vectors
\providecommand{\twovector}[3][r]{\left(\begin{array}{#1} #2 \\ #3\end{array}\right)}
\providecommand{\threevector}[4][r]{\left(\begin{array}{#1}  #2 \\ #3 \\ #4\end{array}\right)}
\providecommand{\fourvector}[5][r]{\left(\begin{array}{#1}  #2 \\ #3 \\ #4 \\ #5 \end{array}\right)}

\endinput
% chktex 17
