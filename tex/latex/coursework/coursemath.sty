% Notation only. Document environments live in courseenvironments.
\NeedsTeXFormat{LaTeX2e}[2026-06-01]
\ProvidesPackage{coursemath}[2026/09/11 v2.0.0 Shared mathematics notation]
\newif\ifcourse@unicode
\DeclareOption{unicode}{\course@unicodetrue}
\ProcessOptions\relax
\ifcourse@unicode\else\RequirePackage{amssymb}\fi
\RequirePackage{mathtools}
\ifcourse@unicode\else\RequirePackage{bigints}\fi
\ifcourse@unicode\else\RequirePackage{bm}\fi
\RequirePackage[spaced,mleftright]{diffcoeff}

% Backend selection happens when used, allowing unicode-math to load later.
\NewDocumentCommand\course@mathbold{m}{\IfPackageLoadedTF{unicode-math}{%
  \begingroup
  % Text-font math alphabets otherwise escape the Unicode bold selection.
  \let\mathrm\symbfup\let\mathit\symbfit
  \symbf{#1}\endgroup}{\bm{#1}}}
\NewDocumentCommand\mathbold{m}{\ensuremath{\course@mathbold{#1}}}
\NewDocumentCommand\course@boldhat{m}{\IfPackageLoadedTF{unicode-math}{\hat{\symbf{#1}}}{\bm{\hat{#1}}}}
\NewDocumentCommand\course@uprightbold{m}{\IfPackageLoadedTF{unicode-math}{\symbfup{#1}}{\bm{\mathrm{#1}}}}
\NewDocumentCommand\course@uprightboldhat{m}{\IfPackageLoadedTF{unicode-math}{\hat{\symbfup{#1}}}{\bm{\hat{\mathrm{#1}}}}}
\NewDocumentCommand\NN{}{\ensuremath{\mathbb{N}}}
\NewDocumentCommand\ZZ{}{\ensuremath{\mathbb{Z}}}
\NewDocumentCommand\QQ{}{\ensuremath{\mathbb{Q}}}
\NewDocumentCommand\RR{}{\ensuremath{\mathbb{R}}}
\NewDocumentCommand\CC{}{\ensuremath{\mathbb{C}}}
\NewDocumentCommand\dd{}{\mathrm{d}}
% A closed group prevents diffcoeff from treating a following [expression]
% in the document as its optional evaluation-point argument.
\NewDocumentCommand\deriv{O{1}mm}{{\diff[#1]{#2}{#3}}}
\NewDocumentCommand\pderiv{O{1}mm}{{\diffp[#1]{#2}{#3}}}
\NewDocumentCommand\integral{mmmm}{\ensuremath{\int_{#3}^{#4}\!#1\,\mathrm{d}#2}}
\NewDocumentCommand\evalat{mmm}{\ensuremath{\left.#1\right\rvert_{#2}^{#3}}}
\NewDocumentCommand\evalbracket{mmm}{\ensuremath{\left\lbrack#1\right\rvert_{#2}^{#3}}}
\DeclarePairedDelimiter\paren{(}{)}
\DeclarePairedDelimiter\bracket{[}{]}
\DeclarePairedDelimiter\abs{\lvert}{\rvert}
\DeclarePairedDelimiter\norm{\lVert}{\rVert}
\NewDocumentCommand\average{m}{\ensuremath{\left\langle#1\right\rangle}}
\NewDocumentCommand\expectation{m}{\ensuremath{E\!\left[#1\right]}}
\NewDocumentCommand\variance{m}{\ensuremath{\mathrm{Var}(#1)}}
\NewDocumentCommand\covariance{m}{\ensuremath{\operatorname{Cov}\!\left(#1\right)}}
\NewDocumentCommand\probability{m}{\ensuremath{P\!\left(#1\right)}}
\NewDocumentCommand\conditionalprob{mm}{\ensuremath{P\!\left(#1\,\middle|\,#2\right)}}
\NewDocumentCommand\slashfrac{mm}{\ensuremath{\,^{#1}\!/\!_{#2}\,}}
\NewDocumentCommand\mathtext{O{}m}{#1\hspace{0.5em}\text{#2}\hspace{0.5em}}
\NewDocumentCommand\combinations{mm}{{}^{#1}C_{#2}}
\NewDocumentCommand\permutations{mm}{{}^{#1}\!P_{#2}}
\NewDocumentCommand\colvector{O{r}m}{\left(\begin{array}{#1}#2\end{array}\right)}
\NewDocumentCommand\questioneq{}{\stackrel{\text{\small ?}}{=}}
\NewDocumentCommand\checkeq{}{\stackrel{\text{\small\ensuremath{\checkmark}}}{=}}
\NewDocumentCommand\crosseq{}{\stackrel{\text{\small\ensuremath{\times}}}{=}}
\endinput
