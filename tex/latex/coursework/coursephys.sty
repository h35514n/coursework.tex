% Physics notation. Load explicitly from the course preamble.
\NeedsTeXFormat{LaTeX2e}[2026-06-01]
\ProvidesPackage{coursephys}[2026/09/11 v2.0.0 Shared physics notation]
\RequirePackage{coursemath}
\RequirePackage{graphicx}
\RequirePackage{siunitx}
\NewDocumentCommand\separation{}{{\mbox{$\resizebox{.09in}{.08in}{\includegraphics[trim=1em 0 14em 0,clip]{coursework-scriptr}}$}}}
\NewDocumentCommand\separationvect{}{{\mbox{$\resizebox{.09in}{.08in}{\includegraphics[trim=1em 0 14em 0,clip]{coursework-boldr}}$}}}
\NewDocumentCommand\separationunit{}{{\mbox{$\hat{\separationvect}$}}}
\NewDocumentCommand\grad{}{\mathbold{\nabla}}
\NewDocumentCommand\laplacian{}{\mathbold{\nabla}^{2}\,}
\NewDocumentCommand\vect{m}{\ensuremath{\,\mathbold{#1}}}
\NewDocumentCommand\uprightvect{m}{\ensuremath{\,\course@uprightbold{#1}}}
\NewDocumentCommand\unitvect{m}{\ensuremath{\,\course@boldhat{#1}}}
\NewDocumentCommand\uprightunitvect{m}{\ensuremath{\,\course@uprightboldhat{#1}}}
\NewDocumentCommand\xhat{}{\,\,\course@uprightboldhat{x}}
\NewDocumentCommand\yhat{}{\,\,\course@uprightboldhat{y}}
\NewDocumentCommand\zhat{}{\,\,\course@uprightboldhat{z}}
\NewDocumentCommand\rhat{}{\,\,\course@uprightboldhat{r}}
\NewDocumentCommand\shat{}{\,\,\course@uprightboldhat{s}}
\NewDocumentCommand\thetahat{}{\,\,\course@boldhat{\theta}}
\NewDocumentCommand\phihat{}{\,\,\course@boldhat{\phi}}
% These glyph variants denote integration domains in the source courses.
% NFSS declarations are confined to the legacy backend. Unicode fonts use
% ordinary italic v/s/p, matching the original notes backend.
\IfPackageLoadedF{unicode-math}{%
 \DeclareSymbolFont{course@region}{OML}{txmi}{m}{it}%
 \DeclareMathSymbol{\course@volume}{\mathord}{course@region}{118}%
 \DeclareMathSymbol{\course@surface}{\mathord}{course@region}{115}%
 \DeclareMathSymbol{\course@path}{\mathord}{course@region}{112}}
\NewDocumentCommand\volumeregion{}{\IfPackageLoadedTF{unicode-math}{\mathit{v}}{\course@volume}}
\NewDocumentCommand\surfaceregion{}{\IfPackageLoadedTF{unicode-math}{\mathit{s}}{\course@surface}}
\NewDocumentCommand\pathregion{}{\IfPackageLoadedTF{unicode-math}{\mathit{p}}{\course@path}}
\NewDocumentCommand\kB{}{\ensuremath{k_{\mathrm{B}}}}
\NewDocumentCommand\NA{}{\ensuremath{N_{\mathrm{A}}}}
\NewDocumentCommand\dbar{}{\mathop{}\!\text{\dj}}
\ExplSyntaxOn
\NewDocumentCommand\constantvalue{m}
 {\str_case:nnF{#1}
  {{boltzmann}{\ensuremath{\qty{1.381e-23}{\joule\per\kelvin}}}
   {avogadro}{\ensuremath{\qty{6.022e23}{\per\mole}}}}
  {\PackageError{coursephys}{Unknown~constant~'#1'}{Use~boltzmann~or~avogadro.}}}
\ExplSyntaxOff
\endinput
